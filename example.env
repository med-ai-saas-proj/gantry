# Example environment variables for .env
GROQ_API_KEY=<YOUR_GROQ_API_KEY> # !SECRET
GOOGLE_PROGRAMMABLE_SEARCH_API_KEY=<YOUR_GOOGLE_PROGRAMMABLE_SEARCH_API_KEY> # !SECRET
GOOGLE_PROGRAMMABLE_SEARCH_CX=577d154875b3c45a5

MODELS_CONFIGS=<YOUR_MODELS_CONFIGS> # !SECRET

STAGE=DEV
DEBUG=1
OTLP_ENDPOINT=localhost:4317
ALLOWED_ORIGINS='["http://localhost:3000"]'

DB_POSTGRES_CONNECTION_URI=postgresql+asyncpg://internet_crawler:123456@localhost:5432/tailm
DB_REDIS_CONNECTION_URI=redis://:password123@localhost:6379/0

AUTH_SERVER_URL=http://localhost:8080/
AUTH_CLIENT_ID=med-ai-saas-app
AUTH_REALM_NAME=dev

APIKEYS_SECRET=thisisasecret
APIKEYS_SECRET_LENGTH=32

ORG_KEYCLOAK_SERVICE_CLIENT_SECRET=<YOUR_ORG_KEYCLOAK_SERVICE_CLIENT_SECRET> # !SECRET
ORG_KEYCLOAK_SERVICE_CLIENT_ID=<YOUR_ORG_KEYCLOAK_SERVICE_CLIENT_ID> # !SECRET

CONVERSATION_CACHE_LIMIT=50
CONVERSATION_CACHE_TTL=600

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

OBJECTSTORAGE_S3_BUCKET_NAME=<YOUR_OBJECTSTORAGE_S3_BUCKET_NAME> # !SECRET
OBJECTSTORAGE_S3_REGION_NAME=<YOUR_OBJECTSTORAGE_S3_REGION_NAME> # !SECRET
OBJECTSTORAGE_S3_ACCESS_KEY_ID=<YOUR_OBJECTSTORAGE_S3_ACCESS_KEY_ID> # !SECRET
OBJECTSTORAGE_S3_SECRET_ACCESS_KEY=<YOUR_OBJECTSTORAGE_S3_SECRET_ACCESS_KEY> # !SECRET
OBJECTSTORAGE_S3_ENDPOINT_URL=<YOUR_OBJECTSTORAGE_S3_ENDPOINT_URL> # !SECRET
OBJECTSTORAGE_S3_PRESIGNED_URL_EXPIRY_SECONDS=3600
OBJECTSTORAGE_REDIS_CACHE_EXPIRY_SECONDS=3600
