{
  "$defs": {
    "ApiGatewayPermission": {
      "properties": {
        "id": {
          "description": "Unique permission identifier.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human-readable permission name.",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "description": "Explanation of what this permission grants.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "ApiGatewayPermission",
      "type": "object"
    },
    "ApiGatewayRoute": {
      "properties": {
        "address": {
          "description": "Upstream service address for this route.",
          "title": "Address",
          "type": "string"
        },
        "required_perms": {
          "default": [],
          "description": "Permission IDs required to access this route.",
          "items": {
            "type": "string"
          },
          "title": "Required Perms",
          "type": "array"
        },
        "auto_hold": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Credits to hold automatically per request.",
          "title": "Auto Hold"
        },
        "auto_charge": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Credits to charge automatically per request.",
          "title": "Auto Charge"
        },
        "rate_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum requests per minute for this route.",
          "title": "Rate Limit"
        }
      },
      "required": [
        "address"
      ],
      "title": "ApiGatewayRoute",
      "type": "object"
    },
    "ApiGatewaySettings": {
      "properties": {
        "permissions": {
          "default": [],
          "description": "Available API gateway permissions.",
          "items": {
            "$ref": "#/$defs/ApiGatewayPermission"
          },
          "title": "Permissions",
          "type": "array"
        },
        "routes": {
          "additionalProperties": {
            "$ref": "#/$defs/ApiGatewayRoute"
          },
          "default": {},
          "description": "Route definitions keyed by route name.",
          "title": "Routes",
          "type": "object"
        }
      },
      "title": "ApiGatewaySettings",
      "type": "object"
    },
    "ApiKeysSettings": {
      "additionalProperties": false,
      "properties": {
        "secret": {
          "description": "Secret key used for API key HMAC signing.",
          "format": "password",
          "title": "Secret",
          "type": "string",
          "writeOnly": true
        },
        "secret_length": {
          "default": 32,
          "description": "Length of generated API key secrets.",
          "exclusiveMinimum": 16,
          "title": "Secret Length",
          "type": "integer"
        }
      },
      "required": [
        "secret"
      ],
      "title": "ApiKeysSettings",
      "type": "object"
    },
    "AppStage": {
      "enum": [
        "DEV",
        "PROD",
        "STAGING"
      ],
      "title": "AppStage",
      "type": "string"
    },
    "AuthSettings": {
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "default": "example_client",
          "description": "Keycloak OIDC client ID.",
          "title": "Client Id",
          "type": "string"
        },
        "admin_client_id": {
          "default": "example_admin_client",
          "description": "Keycloak OIDC client ID for admin users.",
          "title": "Admin Client Id",
          "type": "string"
        }
      },
      "title": "AuthSettings",
      "type": "object"
    },
    "BillingSettings": {
      "additionalProperties": false,
      "properties": {
        "stripe_secret_key": {
          "description": "Stripe API secret key.",
          "format": "password",
          "title": "Stripe Secret Key",
          "type": "string",
          "writeOnly": true
        },
        "stripe_webhook_secret": {
          "description": "Stripe webhook signing secret.",
          "format": "password",
          "title": "Stripe Webhook Secret",
          "type": "string",
          "writeOnly": true
        },
        "invoice_process_interval_seconds": {
          "default": 60,
          "description": "Interval in seconds for processing invoices in the management service",
          "title": "Invoice Process Interval Seconds",
          "type": "integer"
        },
        "transaction_expire_check_interval_seconds": {
          "default": 60,
          "description": "Interval in seconds for checking and closing expired transactions",
          "title": "Transaction Expire Check Interval Seconds",
          "type": "integer"
        }
      },
      "required": [
        "stripe_secret_key",
        "stripe_webhook_secret"
      ],
      "title": "BillingSettings",
      "type": "object"
    },
    "ConversationSettings": {
      "additionalProperties": false,
      "properties": {
        "cache_ttl": {
          "default": 600,
          "description": "Conversation cache TTL in seconds.",
          "title": "Cache Ttl",
          "type": "integer"
        },
        "cache_limit": {
          "default": 50,
          "description": "Maximum number of cached conversations per user.",
          "title": "Cache Limit",
          "type": "integer"
        }
      },
      "title": "ConversationSettings",
      "type": "object"
    },
    "DBSettings": {
      "additionalProperties": false,
      "properties": {
        "pgvector_connection_uri": {
          "description": "PostgreSQL connection URI for the pgvector database.",
          "format": "multi-host-uri",
          "minLength": 1,
          "title": "Pgvector Connection Uri",
          "type": "string"
        },
        "timescale_connection_uri": {
          "description": "PostgreSQL connection URI for TimescaleDB.",
          "format": "multi-host-uri",
          "minLength": 1,
          "title": "Timescale Connection Uri",
          "type": "string"
        },
        "redis_connection_uri": {
          "description": "Redis connection URI for caching.",
          "format": "uri",
          "minLength": 1,
          "title": "Redis Connection Uri",
          "type": "string"
        }
      },
      "required": [
        "pgvector_connection_uri",
        "timescale_connection_uri",
        "redis_connection_uri"
      ],
      "title": "DBSettings",
      "type": "object"
    },
    "ExporterProtocol": {
      "enum": [
        "grpc",
        "http/protobuf"
      ],
      "title": "ExporterProtocol",
      "type": "string"
    },
    "KeycloakSettings": {
      "additionalProperties": false,
      "properties": {
        "server_url": {
          "default": "http://localhost:8000/",
          "description": "Keycloak server base URL.",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Server Url",
          "type": "string"
        },
        "realm_name": {
          "default": "example_realm",
          "description": "Keycloak realm name.",
          "title": "Realm Name",
          "type": "string"
        }
      },
      "title": "KeycloakSettings",
      "type": "object"
    },
    "LogLevel": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL",
        "FATAL"
      ],
      "title": "LogLevel",
      "type": "string"
    },
    "LogsType": {
      "enum": [
        "otlp",
        "disabled"
      ],
      "title": "LogsType",
      "type": "string"
    },
    "MetricsType": {
      "enum": [
        "otlp",
        "prometheus",
        "disabled"
      ],
      "title": "MetricsType",
      "type": "string"
    },
    "ObjectStorageSettings": {
      "additionalProperties": false,
      "properties": {
        "s3_bucket_name": {
          "description": "S3 bucket name for file storage.",
          "title": "S3 Bucket Name",
          "type": "string"
        },
        "s3_region_name": {
          "description": "AWS region for the S3 bucket.",
          "title": "S3 Region Name",
          "type": "string"
        },
        "s3_access_key_id": {
          "description": "AWS access key ID for S3.",
          "title": "S3 Access Key Id",
          "type": "string"
        },
        "s3_secret_access_key": {
          "description": "AWS secret access key for S3.",
          "title": "S3 Secret Access Key",
          "type": "string"
        },
        "s3_endpoint_url": {
          "description": "S3-compatible endpoint URL.",
          "title": "S3 Endpoint Url",
          "type": "string"
        },
        "s3_presigned_url_expiry_seconds": {
          "default": 3600,
          "description": "Presigned URL expiry time in seconds.",
          "title": "S3 Presigned Url Expiry Seconds",
          "type": "integer"
        },
        "redis_cache_expiry_seconds": {
          "default": 3600,
          "description": "Redis cache expiry for file metadata in seconds.",
          "title": "Redis Cache Expiry Seconds",
          "type": "integer"
        }
      },
      "required": [
        "s3_bucket_name",
        "s3_region_name",
        "s3_access_key_id",
        "s3_secret_access_key",
        "s3_endpoint_url"
      ],
      "title": "ObjectStorageSettings",
      "type": "object"
    },
    "ObservabilitySettings": {
      "additionalProperties": false,
      "properties": {
        "exporter_otlp_endpoint": {
          "default": "http://localhost:4317/",
          "description": "OTLP exporter endpoint URL.",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Exporter Otlp Endpoint",
          "type": "string"
        },
        "exporter_otlp_protocol": {
          "$ref": "#/$defs/ExporterProtocol",
          "default": "grpc",
          "description": "OTLP exporter protocol (gRPC or HTTP)."
        },
        "traces": {
          "$ref": "#/$defs/TracesType",
          "default": "disabled",
          "description": "Traces exporter type."
        },
        "metrics": {
          "$ref": "#/$defs/MetricsType",
          "default": "disabled",
          "description": "Metrics exporter type."
        },
        "logs": {
          "$ref": "#/$defs/LogsType",
          "default": "disabled",
          "description": "Logs exporter type."
        },
        "prometheus_port": {
          "default": 9000,
          "description": "Port for the Prometheus metrics endpoint.",
          "title": "Prometheus Port",
          "type": "integer"
        }
      },
      "title": "ObservabilitySettings",
      "type": "object"
    },
    "OrgSettings": {
      "additionalProperties": false,
      "properties": {
        "keycloak_service_client_id": {
          "default": "med-ai-saas-backend",
          "description": "Service account client id for Keycloak Admin API calls.",
          "title": "Keycloak Service Client Id",
          "type": "string"
        },
        "keycloak_service_client_secret": {
          "description": "Service account client secret for Keycloak Admin API calls.",
          "title": "Keycloak Service Client Secret",
          "type": "string"
        },
        "invite_redirect_uri": {
          "default": "http://localhost:3000",
          "description": "Redirect URI used for invitation registration links.",
          "title": "Invite Redirect Uri",
          "type": "string"
        },
        "default_rate_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Global default rate-limit (requests/min). Individual orgs can override this.",
          "title": "Default Rate Limit"
        },
        "deletion_cancel_window_days": {
          "default": 30,
          "description": "How many days an org deletion request can be canceled before hard deletion.",
          "minimum": 1,
          "title": "Deletion Cancel Window Days",
          "type": "integer"
        },
        "deletion_worker_interval_seconds": {
          "default": 60,
          "description": "Background worker interval for processing due deletions.",
          "minimum": 5,
          "title": "Deletion Worker Interval Seconds",
          "type": "integer"
        }
      },
      "required": [
        "keycloak_service_client_secret"
      ],
      "title": "OrgSettings",
      "type": "object"
    },
    "RagSettings": {
      "additionalProperties": false,
      "properties": {
        "openai_api_key": {
          "format": "password",
          "title": "Openai Api Key",
          "type": "string",
          "writeOnly": true
        },
        "openai_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openai Base Url"
        },
        "embedding_model": {
          "title": "Embedding Model",
          "type": "string"
        },
        "rag_store_dimension": {
          "default": 1536,
          "title": "Rag Store Dimension",
          "type": "integer"
        },
        "rag_store_index_type": {
          "$ref": "#/$defs/VectorIndexType",
          "default": "hnsw"
        },
        "rag_store_index_params_hnsw_m": {
          "default": 16,
          "title": "Rag Store Index Params Hnsw M",
          "type": "integer"
        },
        "rag_store_index_params_hnsw_ef_construction": {
          "default": 200,
          "title": "Rag Store Index Params Hnsw Ef Construction",
          "type": "integer"
        },
        "rag_store_index_params_ivfflat_lists": {
          "default": 100,
          "title": "Rag Store Index Params Ivfflat Lists",
          "type": "integer"
        },
        "rag_store_ops_type": {
          "$ref": "#/$defs/VectorOpsType",
          "default": "vector_cosine_ops"
        }
      },
      "required": [
        "openai_api_key",
        "embedding_model"
      ],
      "title": "RagSettings",
      "type": "object"
    },
    "TracesType": {
      "enum": [
        "otlp",
        "disabled"
      ],
      "title": "TracesType",
      "type": "string"
    },
    "UserLogSettings": {
      "additionalProperties": false,
      "properties": {
        "loki_url": {
          "default": "http://localhost:3100/",
          "description": "Loki server URL for user activity logs.",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Loki Url",
          "type": "string"
        }
      },
      "title": "UserLogSettings",
      "type": "object"
    },
    "VectorIndexType": {
      "enum": [
        "ivfflat",
        "hnsw"
      ],
      "title": "VectorIndexType",
      "type": "string"
    },
    "VectorOpsType": {
      "enum": [
        "vector_l2_ops",
        "vector_cosine_ops",
        "vector_ip_ops"
      ],
      "title": "VectorOpsType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "stage": {
      "$ref": "#/$defs/AppStage",
      "default": "DEV",
      "description": "Application deployment stage."
    },
    "allowed_origins": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "const": "*",
          "type": "string"
        }
      ],
      "default": "*",
      "description": "CORS allowed origins. Use '*' to allow all.",
      "title": "Allowed Origins"
    },
    "host": {
      "default": "127.0.0.1",
      "description": "Host address to bind the server to.",
      "title": "Host",
      "type": "string"
    },
    "port": {
      "default": 8000,
      "description": "Port for the public-facing main application.",
      "title": "Port",
      "type": "integer"
    },
    "internal_port": {
      "default": 9000,
      "description": "Port for the internal API and metrics.",
      "title": "Internal Port",
      "type": "integer"
    },
    "log_level": {
      "$ref": "#/$defs/LogLevel",
      "default": "WARNING",
      "description": "Minimum log level for the application."
    },
    "db": {
      "$ref": "#/$defs/DBSettings",
      "description": "Database connection settings."
    },
    "apikey": {
      "$ref": "#/$defs/ApiKeysSettings",
      "description": "API key generation and validation settings."
    },
    "keycloak": {
      "$ref": "#/$defs/KeycloakSettings",
      "description": "Keycloak server and realm."
    },
    "auth": {
      "$ref": "#/$defs/AuthSettings",
      "description": "Keycloak authentication settings."
    },
    "billing": {
      "$ref": "#/$defs/BillingSettings",
      "description": "Stripe billing and invoice settings."
    },
    "user_log": {
      "$ref": "#/$defs/UserLogSettings",
      "description": "User activity log settings."
    },
    "conversation": {
      "$ref": "#/$defs/ConversationSettings",
      "description": "Conversation caching settings."
    },
    "file_storage": {
      "$ref": "#/$defs/ObjectStorageSettings",
      "description": "S3-compatible object storage settings."
    },
    "organization": {
      "$ref": "#/$defs/OrgSettings",
      "description": "Organization management settings."
    },
    "observability": {
      "$ref": "#/$defs/ObservabilitySettings",
      "description": "OpenTelemetry observability settings."
    },
    "api_gateway": {
      "$ref": "#/$defs/ApiGatewaySettings",
      "description": "API gateway routing and permissions."
    },
    "rag": {
      "$ref": "#/$defs/RagSettings",
      "description": "RAG config"
    }
  },
  "required": [
    "db",
    "apikey",
    "keycloak",
    "auth",
    "billing",
    "user_log",
    "conversation",
    "file_storage",
    "organization",
    "observability",
    "api_gateway",
    "rag"
  ],
  "title": "AppSettings",
  "type": "object"
}